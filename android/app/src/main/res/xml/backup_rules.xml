<?xml version="1.0" encoding="utf-8"?>
<!-- Android <= 11: no se respalda ningún dato de la app (Auto Backup deshabilitado).
     La app no almacena datos sensibles, pero se excluye todo por precaución (OWASP MASVS-STORAGE). -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
